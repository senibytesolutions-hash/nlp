# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/nlp_database

# Frontend origin allowed to call this API (comma-separate multiple origins)
CLIENT_ORIGIN=http://localhost:5173


# JWT (admin auth) — set this to a long, random string in production
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Used ONLY by `npm run seed:admin` to create/reset the first admin account.
# Change these before seeding, and change the password again after first login.
ADMIN_SEED_EMAIL=admin@nlp.org
ADMIN_SEED_PASSWORD=admin123
